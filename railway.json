{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.api",
    "watchPatterns": [
      "engine/**",
      "api/**",
      "config/**",
      "bench/**",
      "fixtures/**",
      "pyproject.toml",
      "uv.lock",
      "Dockerfile.api"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1,
    "healthcheckTimeout": 60
  }
}
