# Clinibrium Listen — environment (SPECS §11.7). Copy to .env and fill in.
# The ONLY secret is MODEL_API_KEY. Never commit it; never put it in code,
# fixtures, logs or prompts.

# --- API (api/) ---
MODEL_API_KEY=
# mock | replay | live
MUSE_MODE=mock
# 1 = record Meta request/response pairs into fixtures/replays/
MUSE_RECORD=0
# 1 = allow live microphone audio (also requires a valid DEMO_ACCESS_CODE)
LIVE_AUDIO=0
DEMO_ACCESS_CODE=
# Comma-separated browser origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000

# --- Web (web/) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_WS_URL=ws://localhost:8000
